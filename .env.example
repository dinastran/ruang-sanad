# Laju Go — Environment Configuration
# Copy this file to .env and customize before running.

# Server
APP_PORT=8080
APP_ENV=development
# Public base URL, used for links in AI agent (MCP) answers.
# Example: APP_URL=https://dashboard.ruangsanad.com
APP_URL=

# Database (SQLite)
DB_PATH=./data/app.db

# Session
SESSION_SECRET=change-this-in-production
SESSION_TTL=720h

# Cache
NUTSDB_PATH=./data/cache
SESSION_CACHE_BUFFER=5m
USER_CACHE_TTL=30m

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# SMTP / Email (optional — leave empty to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com
FROM_NAME=Laju

# CRM Leads: integrasi bridge CS AI (hermes-cs-bridge) dan GOWA.
# Token ingest dipakai bridge saat mengirim event ke /integrations/cs-ai/events.
# Kosong = endpoint mati (404). Buat dengan: openssl rand -hex 32
CS_BRIDGE_INGEST_TOKEN=
# Alamat sumber yang boleh mengirim event (koma). Default: loopback + docker.
CS_BRIDGE_ALLOWED_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
# Bridge untuk cek status dan (Fase D) kirim follow-up lewat POST /api/outbound.
CS_BRIDGE_URL=http://172.17.0.1:8650
CS_BRIDGE_OUTBOUND_TOKEN=
# Akun GOWA "dashboard" (dikunci ke device keuangan/admin-kelas/koord-guru, tanpa cs-ai).
GOWA_URL=http://127.0.0.1:3000
GOWA_USER=dashboard
GOWA_PASS=
