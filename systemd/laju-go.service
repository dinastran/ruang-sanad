[Unit]
Description=APP_NAME Application
After=network.target

[Service]
Type=simple
# Runs as root for simplicity (single-app personal server). first-deploy.sh
# rewrites the /opt/APP_NAME paths and APP_NAME below to your real values.
User=root
Group=root
WorkingDirectory=/opt/APP_NAME
ExecStart=/opt/APP_NAME/APP_NAME
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=laju-go

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/APP_NAME/data /opt/APP_NAME/storage /opt/APP_NAME/backups

# Environment
EnvironmentFile=/opt/APP_NAME/.env

[Install]
WantedBy=multi-user.target
